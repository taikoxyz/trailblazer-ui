{
  "name": "trailblazer-ui",
  "version": "2.2.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "axios": "^1.9.0"
  },
  "scripts": {
    "dev": "vite dev --host",
    "dev:prod": "vite dev --mode production",
    "dev:i18n-debug": "node scripts/i18nDebug.js && export PUBLIC_DEBUG_I18N=true && pnpm dev",
    "build": "vite build",
    "preview": "vite preview",
    "test:pw": "playwright test",
    "test:unit": "vitest run --silent",
    "test:unit:debug": "vitest run",
    "test:unit:coverage": "vitest run --silent --coverage",
    "test:unit:watch": "vitest",
    "svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "svelte:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --ignore ./wagmi.config.ts --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "eslint . --fix",
    "codegen:abi": "wagmi generate",
    "codegen:subgraph": "graphql-code-generator --config subgraph.codegen.ts"
  },
  "devDependencies": {
    "@apollo/client": "^3.13.8",
    "@ethereumjs/util": "^9.1.0",
    "@graphql-codegen/cli": "^5.0.6",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "@metamask/eth-sig-util": "^7.0.3",
    "@playwright/test": "^1.52.0",
    "@reown/appkit": "^1.7.6",
    "@reown/appkit-adapter-wagmi": "^1.7.6",
    "@sveltejs/adapter-auto": "^3.3.1",
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/adapter-vercel": "^5.7.2",
    "@sveltejs/kit": "^2.21.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@types/debug": "^4.1.12",
    "@types/node": "^22.15.21",
    "@types/object-hash": "^3.0.6",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vercel/analytics": "^1.5.0",
    "@vitest/coverage-v8": "^1.6.1",
    "@wagmi/core": "^2.17.2",
    "@zerodevx/svelte-toast": "^0.9.6",
    "abitype": "^1.0.8",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.21",
    "buffer": "^6.0.3",
    "daisyui": "^4.12.24",
    "dayjs": "^1.11.13",
    "debug": "^4.4.1",
    "dotenv": "^16.5.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-svelte": "^2.46.1",
    "ethereum-address": "^0.0.4",
    "events": "^3.3.0",
    "graphql": "^16.11.0",
    "graphql-codegen": "^0.4.0",
    "graphql-codegen-svelte-apollo": "^1.1.0",
    "graphql-tag": "^2.12.6",
    "jsdom": "^24.1.3",
    "lefthook": "^1.11.13",
    "lokijs": "^1.5.12",
    "node-conditions": "^1.2.0",
    "object-hash": "^3.0.0",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "prettier": "^3.5.3",
    "prettier-eslint": "^16.4.2",
    "prettier-plugin-svelte": "^3.4.0",
    "stores": "link:@zerodevx/svelte-toast/stores",
    "super-sitemap": "^1.0.3",
    "svelte": "^4.2.20",
    "svelte-apollo": "^0.5.0",
    "svelte-check": "^3.8.6",
    "svelte-confetti": "^1.4.0",
    "svelte-countdown": "^1.1.2",
    "svelte-flip": "^0.0.11",
    "svelte-i18n": "^4.0.1",
    "tailwindcss": "^3.4.17",
    "trailblazer-contracts": "github:taikoxyz/trailblazer-contracts",
    "ts-morph": "^19.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "viem": "^2.30.0",
    "vite": "^5.4.19",
    "vite-plugin-qrcode": "^0.2.4",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.6.1",
    "vitest-fetch-mock": "^0.2.2",
    "vitest-mock-extended": "1.3.1",
    "wagmi": "^2.15.4"
  }
}
